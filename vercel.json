{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/server.py": {
      "maxDuration": 300,
      "includeFiles": [
        "backend/artifacts/municipality_v1/**",
        "backend/data/default/**",
        "backend/app/config/**"
      ],
      "excludeFiles": "{frontend/**,public/**,scripts/**,backend/tests/**,backend/data/processed/**,backend/data/uploads/**,**/*.md}"
    }
  }
}
